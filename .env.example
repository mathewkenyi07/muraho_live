# ==============================================================================
# MURAHO VOICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Complete template covering all sponsor integrations and API keys.
# Duplicate this file as `.env.local` for local development or populate
# these variables in Render / DigitalOcean App Platform dashboard.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=https://murahovoice.tech

# ------------------------------------------------------------------------------
# 1. ELEVENLABS (Voice AI & Low-Latency Text-to-Speech)
# Track: Best Voice Agent / Most Natural Speech
# Used for real-time speech generation with authentic Kigali French/Kinyarwanda accent.
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=elevenlabs_live_sk_sample_key_1234567890abcdef
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ------------------------------------------------------------------------------
# 2. DIGITALOCEAN (Cloud Infrastructure, Managed Droplets & Object Storage)
# Track: Best Infrastructure / Scalable Cloud Deployment
# Hosts the FastAPI inference service, spatial cache, and static audio assets.
# ------------------------------------------------------------------------------
DIGITALOCEAN_HOST=https://muraho-worker-do-fra1.ondigitalocean.app
DIGITALOCEAN_API_TOKEN=dop_v1_sample_digitalocean_personal_access_token_abcdef123456
DIGITALOCEAN_SPACES_KEY=DO00SAMPLESPACESKEY
DIGITALOCEAN_SPACES_SECRET=secret_sample_spaces_token_xyz987654321
DIGITALOCEAN_SPACES_BUCKET=muraho-voice-assets
DIGITALOCEAN_SPACES_REGION=ams3

# ------------------------------------------------------------------------------
# 3. TINKER (Agentic Tool Execution & MicroVM Sandboxing)
# Track: Best Autonomous Agent / Tool Calling
# Sandboxes external computations, USSD string validations, and route checks.
# ------------------------------------------------------------------------------
TINKER_API_KEY=tinker_sec_live_sample_token_882991048201
TINKER_WORKSPACE_ID=ws_kigali_transit_sandbox
TINKER_API_BASE=https://api.tinker.run/v1

# ------------------------------------------------------------------------------
# 4. BACKBOARD (Real-Time State Sync, Memory & Multi-Tenant Sessions)
# Track: Best Realtime Architecture / State Synchronization
